rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Movies collection: Allow read and write for catalog and admin movie uploads
    match /movies/{movieId} {
      allow read: if true;
      allow write: if true;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Site settings: SEO tokens, Monetag, and Adsterra configurations
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
